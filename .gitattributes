# Ensure consistent line endings
* text=auto eol=lf

# Cargo files
Cargo.toml text

# Ignore diffs for generated files
*.lock -diff
*.log -diff

# Binary artifacts
*.exe binary
*.dll binary
*.so  binary
*.dylib binary
*.a   binary
*.lib binary

# Shell scripts
*.sh text eol=lf

# Rust source
*.rs text eol=lf

# Markdown
*.md text eol=lf

# Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf