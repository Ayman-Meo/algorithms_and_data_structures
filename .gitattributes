# Ensure consistent line endings
* text=auto eol=lf

# Rust source files
*.rs text diff=rust

# Cargo files
Cargo.toml text
Cargo.lock text merge=union

# Build scripts
build.rs text diff=rust

# Documentation
*.md text
*.txt text

# Ignore diffs for generated files
*.lock -diff
*.log -diff

# Binary artifacts
*.exe binary
*.dll binary
*.so  binary
*.dylib binary
*.a   binary
*.lib binary

# Shell scripts
*.sh text eol=lf

# Rust source
*.rs text eol=lf

# Markdown
*.md text eol=lf

# Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf